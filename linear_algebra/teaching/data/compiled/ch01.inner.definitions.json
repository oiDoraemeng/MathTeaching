  "stages": [
    {
      "anchor": [
        0.0,
        2.65
      ],
      "caption": "$\\boldsymbol a=(2,1)$ 与 $\\boldsymbol b=(1,2)$ 从同一原点出发，夹角为 $\\theta$；几何定义 $\\boldsymbol a\\cdot\\boldsymbol b=\\lvert\\boldsymbol a\\rvert\\,\\lvert\\boldsymbol b\\rvert\\cos\\theta=\\sqrt5\\cdot\\sqrt5\\cdot\\dfrac45=4$。",
      "id": "stage.case.ch01.inner.definitions.1",
      "layout": "overlay",
      "title": "第一步：几何定义",
      "visible_aliases": [
        "sem__case1_a",
        "sem__case1_a__end",
        "sem__case1_a__origin",
        "sem__case1_b",
        "sem__case1_b__end",
        "sem__case1_b__origin",
        "sem__rel.angle.ch01.inner.definitions.1",
        "sem__orientation__1"
      ],
      "visible_refs": [
        "case1_a",
        "case1_b",
        "rel.angle.ch01.inner.definitions.1"
      ]
    },
    {
      "anchor": [
        0.0,
        2.65
      ],
      "caption": "$\\boldsymbol b$ 在 $\\boldsymbol a$ 上的投影（虚线）为 $\\boldsymbol p=(1.6,0.8)$，投影长度 $\\lvert\\boldsymbol b\\rvert\\cos\\theta=\\dfrac4{\\sqrt5}$；乘以 $\\lvert\\boldsymbol a\\rvert=\\sqrt5$ 得 $\\boldsymbol a\\cdot\\boldsymbol b=4$，与按坐标分量相乘再相加（$2\\times1+1\\times2=4$）一致。",
      "id": "stage.case.ch01.inner.definitions.2",
      "layout": "overlay",
      "title": "第二步：代数定义",
