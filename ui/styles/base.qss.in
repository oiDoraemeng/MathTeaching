QMainWindow, #viewportHost { background: $bg_canvas; color: $text_primary; }
#algebraPanel, #agentSidebar { background: $bg_panel; }
#algebraPanel { border: 0; }
#algebraTitle { color: $text_primary; font-size: ${size_title}px; font-weight: 600; }
#sectionHeader { color: $text_secondary; font-size: ${size_caption}px; letter-spacing: 0.2px; }
#algebraLayerRow, #catalogEntryRow { background: $bg_elevated; border: 1px solid transparent; border-radius: ${radius_md}px; }
#algebraLayerRow:hover { border-color: $border_default; }
#algebraLayerRow[selected="true"] { background: $accent_soft_bg; border: 1px solid $accent_default; }
#catalogEntryRow:hover { background: $accent_soft_bg; border-color: $border_strong; }
#catalogCategory, #algebraStatus { color: $text_secondary; font-size: ${size_caption}px; }
#catalogCategory { font-weight: 700; padding: ${space_s2}px 2px 2px 2px; }
#algebraStatus { padding-top: 2px; }
#algebraStatus[isError="true"] { color: $status_error; }
#linearAlgebraSearch { min-height: 32px; padding: 2px ${space_s2}px; }
#linearAlgebraTree { background: $bg_overlay; color: $text_primary; border: 1px solid $border_subtle; border-radius: ${radius_md}px; outline: 0; }
#linearAlgebraTree::item { min-height: 30px; padding: 2px ${space_s1}px; }
#linearAlgebraTree::item:hover { background: $accent_soft_bg; }
#linearAlgebraTree::item:selected { background: $accent_soft_bg; color: $text_primary; border-left: 2px solid $accent_default; }
#linearAlgebraExpandButton, #linearAlgebraCollapseButton { min-width: 32px; min-height: 32px; }
#linearAlgebraContentTitle { color: $text_primary; font-size: ${size_subtitle}px; font-weight: 600; }
#linearAlgebraFormula { color: $accent_default; }
#appStatusBar { background: $bg_panel; border-top: 1px solid $border_default; }
#appStatusBar QLabel { color: $text_secondary; font-size: ${size_caption}px; }
#appStatusBar QToolButton { min-width: 24px; min-height: 24px; border-radius: ${radius_sm}px; }
#appStatusBar QToolButton:hover { background: $bg_elevated; }
QScrollArea { border: 0; background: $bg_panel; }
QLabel { color: $text_secondary; font-size: ${size_body}px; }
QLineEdit, QComboBox, QPushButton {
  min-height: 32px; color: $text_primary; background: $bg_panel;
  border: 1px solid $border_default; border-radius: ${radius_sm}px;
}
QLineEdit, QComboBox { padding: 2px 7px; }
QLineEdit:focus, QComboBox:focus, QPushButton:focus { border: 1px solid $border_default; }
QLineEdit:focus-visible, QComboBox:focus-visible, QPushButton:focus-visible, QToolButton:focus-visible { border: 2px solid $accent_default; }
QPushButton { background: $bg_elevated; color: $accent_default; padding: 3px 8px; font-weight: 600; }
QPushButton:hover { background: $accent_soft_bg; }
QToolButton { min-width: 24px; min-height: 24px; color: $text_secondary; border: 1px solid transparent; border-radius: ${radius_sm}px; }
QToolButton:hover { background: $bg_elevated; border-color: $border_default; }
QCheckBox { color: $text_secondary; spacing: ${space_s1}px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid $border_strong; border-radius: 3px; background: $bg_panel; }
QCheckBox::indicator:checked { background: $accent_default; border-color: $accent_default; }
QSlider::groove:horizontal { height: 4px; background: $border_default; border-radius: 2px; }
QSlider::handle:horizontal { width: 13px; margin: -5px 0; border-radius: 6px; background: $accent_default; }
QDialog {
  background: $bg_overlay; border: 1px solid $border_subtle; border-radius: ${radius_lg}px;
}
QDialogButtonBox {
  spacing: ${space_s2}px;
}
QDialogButtonBox QPushButton {
  min-height: 32px;
  padding: 3px 10px;
}
QGroupBox {
  margin-top: 12px;
  padding: 10px 10px 8px 10px;
  color: $text_primary;
  border: 1px solid $border_default;
  border-radius: ${radius_md}px;
}
QGroupBox::title {
  padding: 0 4px;
  margin-left: 6px;
  color: $text_secondary;
  background: $bg_overlay;
}
#viewportToolbar, #twoDGeometryToolbar, #twoDLineFlyout, #sceneSettingsPanel {
  background: $bg_overlay; border: 1px solid $border_subtle; border-radius: ${radius_md}px;
}
#layerSettingsPopup, #geometrySettingsPopup, #intersectionPopup, #functionCatalogPopup, #formulaEditorPopup,
#linearAlgebraDialog {
  background: $bg_overlay; border: 1px solid $border_default; border-radius: ${radius_lg}px;
}
#settingsPopupTitle { color: $text_primary; font-size: ${size_subtitle}px; font-weight: 600; }
#viewportToolbar QToolButton, #twoDGeometryToolbar QToolButton, #twoDLineFlyout QToolButton { font-size: 18px; font-weight: 700; }
#viewportToolbar QToolButton:hover, #twoDGeometryToolbar QToolButton:hover, #twoDLineFlyout QToolButton:hover {
  background: $accent_soft_bg; border-color: $border_subtle; color: $accent_default;
}
#agentButton:checked, #twoDGeometryToolbar QToolButton:checked, #twoDLineFlyout QToolButton:checked {
  background: $accent_soft_bg; border-color: $accent_default; color: $accent_default;
}
