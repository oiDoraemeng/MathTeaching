QMainWindow, #viewportHost { background: #eef1f4; color: #17212e; }\n#algebraPanel, #agentSidebar { background: #ffffff; }\n#algebraPanel { border-right: 1px solid #d5dbe3; }\n#agentPanel { background: #ffffff; border-left: 1px solid #b8c2cd; border-radius: 0; }\n#algebraTitle, #agentTitle { color: #17212e; font-weight: 700; }\n#algebraTitle { font-size: 15px; }\n#agentTitle { font-size: 13px; }\n#algebraLayerRow, #catalogEntryRow { background: #f5f7f9; border: 1px solid #d5dbe3; border-radius: 4px; }\n#catalogEntryRow:hover { background: #e4f0f9; border-color: #b8c2cd; }\n#catalogCategory, #algebraStatus { color: #3f4c5c; font-size: 11px; }\n#catalogCategory { font-weight: 700; padding: 8px 2px 2px 2px; }\n#algebraStatus { padding-top: 2px; }\n#algebraStatus[isError="true"], #agentPlanProblems { color: #b42318; }\nQScrollArea { border: 0; background: #ffffff; }\nQLabel { color: #3f4c5c; font-size: 12px; }\nQLineEdit, QComboBox, QPushButton {\n  min-height: 32px; color: #17212e; background: #ffffff;\n  border: 1px solid #d5dbe3; border-radius: 4px;\n}\nQLineEdit, QComboBox { padding: 2px 7px; }\nQLineEdit:focus, QComboBox:focus, QPushButton:focus { border: 2px solid #2f7ebd; }\nQPushButton { background: #f5f7f9; color: #2f7ebd; padding: 3px 8px; font-weight: 600; }\nQPushButton:hover { background: #e4f0f9; }\nQToolButton { min-width: 24px; min-height: 24px; color: #3f4c5c; border: 1px solid transparent; border-radius: 4px; }\nQToolButton:hover { background: #f5f7f9; border-color: #d5dbe3; }\nQCheckBox { color: #3f4c5c; spacing: 4px; }\nQCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #b8c2cd; border-radius: 3px; background: #ffffff; }\nQCheckBox::indicator:checked { background: #2f7ebd; border-color: #2f7ebd; }\nQSlider::groove:horizontal { height: 4px; background: #d5dbe3; border-radius: 2px; }\nQSlider::handle:horizontal { width: 13px; margin: -5px 0; border-radius: 6px; background: #2f7ebd; }\n#layerSettingsPopup, #geometrySettingsPopup, #functionCatalogPopup, #sceneSettingsPanel, #formulaEditorPopup,\n#viewportToolbar, #twoDGeometryToolbar, #twoDLineFlyout {\n  background: #ffffff; border: 1px solid #eceff3; border-radius: 8px;\n}\n#settingsPopupTitle { color: #17212e; font-size: 13px; font-weight: 600; }\n#viewportToolbar QToolButton, #twoDGeometryToolbar QToolButton, #twoDLineFlyout QToolButton { font-size: 18px; font-weight: 700; }\n#agentButton:checked, #agentNavAgent:checked, #agentNavSkills:checked, #agentNavMemory:checked, #agentNavRules:checked,\n#twoDGeometryToolbar QToolButton:checked, #twoDLineFlyout QToolButton:checked {\n  background: #e4f0f9; border-color: #2f7ebd; color: #2f7ebd;\n}\n#agentCollapsedBar, #agentMessageScroll { background: #f5f7f9; }\n#agentCollapsedBar { border-left: 0; }\n#agentCollapsedLabel, #agentStatus { color: #66788c; font-size: 11px; }\n#agentCollapsedLabel { font-weight: 600; }\n#agentNavAgent, #agentNavSkills, #agentNavMemory, #agentNavRules { min-height: 28px; text-align: left; }\n#agentModeHint { color: #8a5a00; background: #e4f0f9; border: 1px solid #d5dbe3; border-radius: 4px; padding: 5px; }\n#agentMessageScroll { border: 1px solid #eceff3; border-radius: 5px; }\n#agentUserBubble { background: #e4f0f9; border: 1px solid #b8c2cd; border-radius: 7px; }\n#agentAssistantBubble { background: #ffffff; border: 1px solid #d5dbe3; border-radius: 7px; }\n#agentPlanCard { background: #f5f7f9; border: 1px solid #b8c2cd; border-radius: 4px; }\n#agentPlanProblems { font-size: 11px; }\n#agentPromptEdit { background: #ffffff; border: 1px solid #d5dbe3; border-radius: 5px; padding: 5px; }\n#agentSendButton { min-height: 34px; }\n
