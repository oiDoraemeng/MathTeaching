QMainWindow, #viewportHost { background: #eef1f4; color: #17212e; }
#algebraPanel, #agentSidebar { background: #ffffff; }
#algebraPanel { border: 0; }
#algebraTitle { color: #17212e; font-size: 15px; font-weight: 600; }
#sectionHeader { color: #3f4c5c; font-size: 11px; letter-spacing: 0.2px; }
#algebraLayerRow, #catalogEntryRow { background: #f5f7f9; border: 1px solid transparent; border-radius: 8px; }
#algebraLayerRow:hover { border-color: #d5dbe3; }
#algebraLayerRow[selected="true"] { background: #e4f0f9; border: 1px solid #2f7ebd; }
#catalogEntryRow:hover { background: #e4f0f9; border-color: #b8c2cd; }
#catalogCategory, #algebraStatus { color: #3f4c5c; font-size: 11px; }
#catalogCategory { font-weight: 700; padding: 8px 2px 2px 2px; }
#algebraStatus { padding-top: 2px; }
#algebraStatus[isError="true"] { color: #b42318; }
#linearAlgebraSearch { min-height: 32px; padding: 2px 8px; }
#linearAlgebraTree { background: #ffffff; color: #17212e; border: 1px solid #eceff3; border-radius: 8px; outline: 0; }
#linearAlgebraTree::item { min-height: 30px; padding: 2px 4px; }
#linearAlgebraTree::item:hover { background: #e4f0f9; }
#linearAlgebraTree::item:selected { background: #e4f0f9; color: #17212e; border-left: 2px solid #2f7ebd; }
#linearAlgebraExpandButton, #linearAlgebraCollapseButton { min-width: 32px; min-height: 32px; }
#linearAlgebraContentTitle { color: #17212e; font-size: 13px; font-weight: 600; }
#linearAlgebraFormula { color: #2f7ebd; }
#appStatusBar { background: #ffffff; border-top: 1px solid #d5dbe3; }
#appStatusBar QLabel { color: #3f4c5c; font-size: 11px; }
#appStatusBar QToolButton { min-width: 24px; min-height: 24px; border-radius: 4px; font-size: 11px; }
#appStatusBar QToolButton:hover { background: #f5f7f9; }
#formulaPreviewFallback { color: #17212e; }
#panelResizeHandle { border-left: 1px solid #d5dbe3; }
#panelResizeHandle:hover, #panelResizeHandle[dragging="true"] { background: #e4f0f9; border-left: 2px solid #2f7ebd; }
QScrollArea { border: 0; background: #ffffff; }
#appTitleBar { background: #ffffff; border-bottom: 1px solid #d5dbe3; }
#appTitle { color: #17212e; font-size: 12px; font-weight: 600; }
#appTitleBar QToolButton { min-width: 32px; min-height: 32px; border: 0; border-radius: 4px; }
#appTitleBar QToolButton:hover { background: #f5f7f9; }
#appTitleBar #titleBarClose:hover { background: #b42318; color: #ffffff; }
QLabel { color: #3f4c5c; font-size: 12px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit, QPushButton {
  min-height: 32px; color: #17212e; background: #ffffff;
  border: 1px solid #d5dbe3; border-radius: 4px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { padding: 2px 7px; }
QPlainTextEdit, QTextEdit { padding: 4px 7px; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
  width: 16px; background: #ffffff; border: 0;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus, QSlider:focus { border: 2px solid #2f7ebd; }
QPushButton { background: #f5f7f9; color: #2f7ebd; padding: 3px 8px; font-weight: 600; }
QPushButton:hover { background: #e4f0f9; }
QToolButton { min-width: 24px; min-height: 24px; color: #3f4c5c; border: 2px solid transparent; border-radius: 4px; font-size: 11px; }
QPushButton { border: 2px solid transparent; }
QPushButton:focus, QToolButton:focus { border: 2px solid #2f7ebd; }
QToolButton:hover { background: #f5f7f9; border-color: #d5dbe3; }
QToolTip { font-size: 11px; }
QMenu { font-size: 12px; }
QComboBox QAbstractItemView { font-size: 12px; }
QTreeView, QListView, QListWidget { font-size: 12px; }
QCheckBox { color: #3f4c5c; spacing: 4px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #b8c2cd; border-radius: 3px; background: #ffffff; }
QCheckBox::indicator:checked { background: #2f7ebd; border-color: #2f7ebd; }
QSlider { border: 2px solid transparent; border-radius: 4px; }
QSlider:focus { border-color: #2f7ebd; }
QSlider::groove:horizontal { height: 4px; background: #d5dbe3; border-radius: 2px; }
QSlider::handle:horizontal { width: 13px; margin: -5px 0; border-radius: 6px; background: #2f7ebd; }
QDialog {
  background: #ffffff; border: 1px solid #eceff3; border-radius: 10px;
}
QDialogButtonBox {
  spacing: 8px;
}
QDialogButtonBox QPushButton {
  min-height: 32px;
  padding: 3px 10px;
}
QGroupBox {
  margin-top: 12px;
  padding: 10px 10px 8px 10px;
  color: #17212e;
  border: 1px solid #d5dbe3;
  border-radius: 8px;
}
QGroupBox::title {
  padding: 0 4px;
  margin-left: 6px;
  color: #3f4c5c;
  background: #ffffff;
}
#viewportToolbar, #twoDGeometryToolbar, #twoDLineFlyout, #sceneSettingsPanel {
  background: #ffffff; border: 1px solid #eceff3; border-radius: 8px;
}
#layerSettingsPopup, #geometrySettingsPopup, #intersectionPopup, #functionCatalogPopup, #formulaEditorPopup,
#linearAlgebraDialog {
  background: #ffffff; border: 1px solid #d5dbe3; border-radius: 10px;
}
#settingsPopupTitle { color: #17212e; font-size: 13px; font-weight: 600; }
#sceneModeButton { font-size: 15px; font-weight: 700; }
#viewportToolbar QToolButton:hover, #twoDGeometryToolbar QToolButton:hover, #twoDLineFlyout QToolButton:hover {
  background: #e4f0f9; border-color: #eceff3; color: #2f7ebd;
}
#agentButton:checked, #viewportToolbar QToolButton:checked, #twoDGeometryToolbar QToolButton:checked, #twoDLineFlyout QToolButton:checked {
  background: #e4f0f9; border-color: #2f7ebd; color: #2f7ebd;
}
#teachingCasePaneHost { background: #eef1f4; }
#teachingCasePane { background: #ffffff; border: 1px solid #d5dbe3; border-radius: 8px; }
#teachingCasePane[selected="true"] { border: 2px solid #2f7ebd; }
#teachingCasePaneTitle { color: #17212e; font-size: 11px; font-weight: 600; }
#teachingCasePaneEmpty { background: #ffffff; border: 1px dashed #d5dbe3; border-radius: 8px; }
#scenePane[activePane="true"] { border: 2px solid #2f7ebd; border-radius: 8px; }
#paneChrome { background: #ffffff; border: 1px solid #d5dbe3; border-radius: 8px; }
#paneChrome[activePane="true"] { border: 2px solid #2f7ebd; }
#paneChromeTitle { color: #17212e; font-size: 11px; font-weight: 600; }
#paneChromeClose { color: #3f4c5c; }
#paneChromeClose:hover { color: #2f7ebd; background: #ffffff; }
