QMainWindow, #viewportHost { background: #1a1b1e; color: #e8eaed; }\n#algebraPanel, #agentSidebar { background: #202124; }\n#algebraPanel { border-right: 1px solid #3c4046; }\n#agentPanel { background: #202124; border-left: 1px solid #52565e; border-radius: 0; }\n#algebraTitle, #agentTitle { color: #e8eaed; font-weight: 700; }\n#algebraTitle { font-size: 15px; }\n#agentTitle { font-size: 13px; }\n#algebraLayerRow, #catalogEntryRow { background: #26282c; border: 1px solid #3c4046; border-radius: 4px; }\n#catalogEntryRow:hover { background: rgba(76,158,232,.16); border-color: #52565e; }\n#catalogCategory, #algebraStatus { color: #b3b8c0; font-size: 11px; }\n#catalogCategory { font-weight: 700; padding: 8px 2px 2px 2px; }\n#algebraStatus { padding-top: 2px; }\n#algebraStatus[isError="true"], #agentPlanProblems { color: #f48771; }\nQScrollArea { border: 0; background: #202124; }\nQLabel { color: #b3b8c0; font-size: 12px; }\nQLineEdit, QComboBox, QPushButton {\n  min-height: 32px; color: #e8eaed; background: #202124;\n  border: 1px solid #3c4046; border-radius: 4px;\n}\nQLineEdit, QComboBox { padding: 2px 7px; }\nQLineEdit:focus, QComboBox:focus, QPushButton:focus { border: 2px solid #4c9ee8; }\nQPushButton { background: #26282c; color: #4c9ee8; padding: 3px 8px; font-weight: 600; }\nQPushButton:hover { background: rgba(76,158,232,.16); }\nQToolButton { min-width: 24px; min-height: 24px; color: #b3b8c0; border: 1px solid transparent; border-radius: 4px; }\nQToolButton:hover { background: #26282c; border-color: #3c4046; }\nQCheckBox { color: #b3b8c0; spacing: 4px; }\nQCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #52565e; border-radius: 3px; background: #202124; }\nQCheckBox::indicator:checked { background: #4c9ee8; border-color: #4c9ee8; }\nQSlider::groove:horizontal { height: 4px; background: #3c4046; border-radius: 2px; }\nQSlider::handle:horizontal { width: 13px; margin: -5px 0; border-radius: 6px; background: #4c9ee8; }\n#layerSettingsPopup, #geometrySettingsPopup, #functionCatalogPopup, #sceneSettingsPanel, #formulaEditorPopup,\n#viewportToolbar, #twoDGeometryToolbar, #twoDLineFlyout {\n  background: #24262a; border: 1px solid #33363b; border-radius: 8px;\n}\n#settingsPopupTitle { color: #e8eaed; font-size: 13px; font-weight: 600; }\n#viewportToolbar QToolButton, #twoDGeometryToolbar QToolButton, #twoDLineFlyout QToolButton { font-size: 18px; font-weight: 700; }\n#agentButton:checked, #agentNavAgent:checked, #agentNavSkills:checked, #agentNavMemory:checked, #agentNavRules:checked,\n#twoDGeometryToolbar QToolButton:checked, #twoDLineFlyout QToolButton:checked {\n  background: rgba(76,158,232,.16); border-color: #4c9ee8; color: #4c9ee8;\n}\n#agentCollapsedBar, #agentMessageScroll { background: #26282c; }\n#agentCollapsedBar { border-left: 0; }\n#agentCollapsedLabel, #agentStatus { color: #8a9099; font-size: 11px; }\n#agentCollapsedLabel { font-weight: 600; }\n#agentNavAgent, #agentNavSkills, #agentNavMemory, #agentNavRules { min-height: 28px; text-align: left; }\n#agentModeHint { color: #cca700; background: rgba(76,158,232,.16); border: 1px solid #3c4046; border-radius: 4px; padding: 5px; }\n#agentMessageScroll { border: 1px solid #33363b; border-radius: 5px; }\n#agentUserBubble { background: rgba(76,158,232,.16); border: 1px solid #52565e; border-radius: 7px; }\n#agentAssistantBubble { background: #202124; border: 1px solid #3c4046; border-radius: 7px; }\n#agentPlanCard { background: #26282c; border: 1px solid #52565e; border-radius: 4px; }\n#agentPlanProblems { font-size: 11px; }\n#agentPromptEdit { background: #202124; border: 1px solid #3c4046; border-radius: 5px; padding: 5px; }\n#agentSendButton { min-height: 34px; }\n
