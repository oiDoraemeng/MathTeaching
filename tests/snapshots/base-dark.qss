QMainWindow, #viewportHost { background: #1a1b1e; color: #e8eaed; }
#algebraPanel, #agentSidebar { background: #202124; }
#algebraPanel { border-right: 1px solid #3c4046; }
#algebraTitle { color: #e8eaed; font-weight: 700; }
#algebraTitle { font-size: 15px; }
#algebraLayerRow, #catalogEntryRow { background: #26282c; border: 1px solid #3c4046; border-radius: 4px; }
#catalogEntryRow:hover { background: rgba(76,158,232,.16); border-color: #52565e; }
#catalogCategory, #algebraStatus { color: #b3b8c0; font-size: 11px; }
#catalogCategory { font-weight: 700; padding: 8px 2px 2px 2px; }
#algebraStatus { padding-top: 2px; }
#algebraStatus[isError="true"] { color: #f48771; }
QScrollArea { border: 0; background: #202124; }
QLabel { color: #b3b8c0; font-size: 12px; }
QLineEdit, QComboBox, QPushButton {
  min-height: 32px; color: #e8eaed; background: #202124;
  border: 1px solid #3c4046; border-radius: 4px;
}
QLineEdit, QComboBox { padding: 2px 7px; }
QLineEdit:focus, QComboBox:focus, QPushButton:focus { border: 2px solid #4c9ee8; }
QPushButton { background: #26282c; color: #4c9ee8; padding: 3px 8px; font-weight: 600; }
QPushButton:hover { background: rgba(76,158,232,.16); }
QToolButton { min-width: 24px; min-height: 24px; color: #b3b8c0; border: 1px solid transparent; border-radius: 4px; }
QToolButton:hover { background: #26282c; border-color: #3c4046; }
QCheckBox { color: #b3b8c0; spacing: 4px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #52565e; border-radius: 3px; background: #202124; }
QCheckBox::indicator:checked { background: #4c9ee8; border-color: #4c9ee8; }
QSlider::groove:horizontal { height: 4px; background: #3c4046; border-radius: 2px; }
QSlider::handle:horizontal { width: 13px; margin: -5px 0; border-radius: 6px; background: #4c9ee8; }
#layerSettingsPopup, #geometrySettingsPopup, #functionCatalogPopup, #sceneSettingsPanel, #formulaEditorPopup,
#linearAlgebraCasePopup, #viewportToolbar, #twoDGeometryToolbar, #twoDLineFlyout {
  background: #24262a; border: 1px solid #33363b; border-radius: 8px;
}
#settingsPopupTitle { color: #e8eaed; font-size: 13px; font-weight: 600; }
#viewportToolbar QToolButton, #twoDGeometryToolbar QToolButton, #twoDLineFlyout QToolButton { font-size: 18px; font-weight: 700; }
#viewportToolbar QToolButton:hover, #twoDGeometryToolbar QToolButton:hover, #twoDLineFlyout QToolButton:hover {
  background: rgba(76,158,232,.16); border-color: #33363b; color: #4c9ee8;
}
#agentButton:checked, #twoDGeometryToolbar QToolButton:checked, #twoDLineFlyout QToolButton:checked {
  background: rgba(76,158,232,.16); border-color: #4c9ee8; color: #4c9ee8;
}
QDialog {
  background: #24262a; border: 1px solid #33363b; border-radius: 10px;
}
