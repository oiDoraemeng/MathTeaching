QMainWindow, #viewportHost { background: #1a1b1e; color: #e8eaed; }
#algebraPanel, #agentSidebar { background: #202124; }
#algebraPanel { border: 0; }
#algebraTitle { color: #e8eaed; font-size: 15px; font-weight: 600; }
#sectionHeader { color: #b3b8c0; font-size: 11px; letter-spacing: 0.2px; }
#algebraLayerRow, #catalogEntryRow { background: #26282c; border: 1px solid transparent; border-radius: 8px; }
#algebraLayerRow:hover { border-color: #3c4046; }
#algebraLayerRow[selected="true"] { background: rgba(76,158,232,.16); border: 1px solid #4c9ee8; }
#catalogEntryRow:hover { background: rgba(76,158,232,.16); border-color: #52565e; }
#catalogCategory, #algebraStatus { color: #b3b8c0; font-size: 11px; }
#catalogCategory { font-weight: 700; padding: 8px 2px 2px 2px; }
#algebraStatus { padding-top: 2px; }
#algebraStatus[isError="true"] { color: #f48771; }
#linearAlgebraSearch { min-height: 32px; padding: 2px 8px; }
#linearAlgebraTree { background: #24262a; color: #e8eaed; border: 1px solid #33363b; border-radius: 8px; outline: 0; }
#linearAlgebraTree::item { min-height: 30px; padding: 2px 4px; }
#linearAlgebraTree::item:hover { background: rgba(76,158,232,.16); }
#linearAlgebraTree::item:selected { background: rgba(76,158,232,.16); color: #e8eaed; border-left: 2px solid #4c9ee8; }
#linearAlgebraExpandButton, #linearAlgebraCollapseButton { min-width: 32px; min-height: 32px; }
#linearAlgebraContentTitle { color: #e8eaed; font-size: 13px; font-weight: 600; }
#linearAlgebraFormula { color: #4c9ee8; }
#appStatusBar { background: #202124; border-top: 1px solid #3c4046; }
#appStatusBar QLabel { color: #b3b8c0; font-size: 11px; }
#appStatusBar QToolButton { min-width: 24px; min-height: 24px; border-radius: 4px; font-size: 11px; }
#appStatusBar QToolButton:hover { background: #26282c; }
#formulaPreviewFallback { color: #e8eaed; }
#panelResizeHandle { border-left: 1px solid #3c4046; }
#panelResizeHandle:hover, #panelResizeHandle[dragging="true"] { background: rgba(76,158,232,.16); border-left: 2px solid #4c9ee8; }
QScrollArea { border: 0; background: #202124; }
#appTitleBar { background: #202124; border-bottom: 1px solid #3c4046; }
#appTitle { color: #e8eaed; font-size: 12px; font-weight: 600; }
#appTitleBar QToolButton { min-width: 32px; min-height: 32px; border: 0; border-radius: 4px; }
#appTitleBar QToolButton:hover { background: #26282c; }
#appTitleBar #titleBarClose:hover { background: #f48771; color: #202124; }
QLabel { color: #b3b8c0; font-size: 12px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit, QPushButton {
  min-height: 32px; color: #e8eaed; background: #202124;
  border: 1px solid #3c4046; border-radius: 4px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { padding: 2px 7px; }
QPlainTextEdit, QTextEdit { padding: 4px 7px; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
  width: 16px; background: #202124; border: 0;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus, QSlider:focus { border: 2px solid #4c9ee8; }
QPushButton { background: #26282c; color: #4c9ee8; padding: 3px 8px; font-weight: 600; }
QPushButton:hover { background: rgba(76,158,232,.16); }
QToolButton { min-width: 24px; min-height: 24px; color: #b3b8c0; border: 2px solid transparent; border-radius: 4px; font-size: 11px; }
QPushButton { border: 2px solid transparent; }
QPushButton:focus, QToolButton:focus { border: 2px solid #4c9ee8; }
QToolButton:hover { background: #26282c; border-color: #3c4046; }
QToolTip { font-size: 11px; }
QMenu { font-size: 12px; }
QComboBox QAbstractItemView { font-size: 12px; }
QTreeView, QListView, QListWidget { font-size: 12px; }
QCheckBox { color: #b3b8c0; spacing: 4px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #52565e; border-radius: 3px; background: #202124; }
QCheckBox::indicator:checked { background: #4c9ee8; border-color: #4c9ee8; }
QSlider { border: 2px solid transparent; border-radius: 4px; }
QSlider:focus { border-color: #4c9ee8; }
QSlider::groove:horizontal { height: 4px; background: #3c4046; border-radius: 2px; }
QSlider::handle:horizontal { width: 13px; margin: -5px 0; border-radius: 6px; background: #4c9ee8; }
QDialog {
  background: #24262a; border: 1px solid #33363b; border-radius: 10px;
}
QDialogButtonBox {
  spacing: 8px;
}
QDialogButtonBox QPushButton {
  min-height: 32px;
  padding: 3px 10px;
}
QGroupBox {
  margin-top: 12px;
  padding: 10px 10px 8px 10px;
  color: #e8eaed;
  border: 1px solid #3c4046;
  border-radius: 8px;
}
QGroupBox::title {
  padding: 0 4px;
  margin-left: 6px;
  color: #b3b8c0;
  background: #24262a;
}
#viewportToolbar, #twoDGeometryToolbar, #twoDLineFlyout, #sceneSettingsPanel {
  background: #24262a; border: 1px solid #33363b; border-radius: 8px;
}
#layerSettingsPopup, #geometrySettingsPopup, #intersectionPopup, #functionCatalogPopup, #formulaEditorPopup,
#linearAlgebraDialog {
  background: #24262a; border: 1px solid #3c4046; border-radius: 10px;
}
#settingsPopupTitle { color: #e8eaed; font-size: 13px; font-weight: 600; }
#sceneModeButton { font-size: 15px; font-weight: 700; }
#viewportToolbar QToolButton:hover, #twoDGeometryToolbar QToolButton:hover, #twoDLineFlyout QToolButton:hover {
  background: rgba(76,158,232,.16); border-color: #33363b; color: #4c9ee8;
}
#agentButton:checked, #twoDGeometryToolbar QToolButton:checked, #twoDLineFlyout QToolButton:checked {
  background: rgba(76,158,232,.16); border-color: #4c9ee8; color: #4c9ee8;
}
#teachingCasePaneHost { background: #1a1b1e; }
#teachingCasePane { background: #202124; border: 1px solid #3c4046; border-radius: 8px; }
#teachingCasePane[selected="true"] { border: 2px solid #4c9ee8; }
#teachingCasePaneTitle { color: #e8eaed; font-size: 11px; font-weight: 600; }
#teachingCasePaneEmpty { background: #202124; border: 1px dashed #3c4046; border-radius: 8px; }
